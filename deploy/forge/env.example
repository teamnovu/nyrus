# nyrus on Laravel Forge: paste this into Forge -> site -> Environment
# (the file /home/forge/nyrus.on-forge.com/.env) and fill in the values.
#
# The Forge daemon starts nyrus with --env-file pointing at that file. nyrus
# watches it and reloads on save; values read only at startup (e.g. the port)
# need a restart:  NYRUS_SKIP_BUILD=1 bash deploy/forge/deploy.sh
# Never commit the real file.

# --- Server (required) ------------------------------------------------------
# Public URL that ClickUp/Jira send webhooks to (Nginx proxies it to the port).
CYRUS_BASE_URL=https://nyrus.on-forge.com
# Port nyrus listens on (localhost only; Nginx forwards to it).
CYRUS_SERVER_PORT=3456
# Shared secret for nyrus's own APIs (generate with: openssl rand -hex 32).
# The nyrus dashboard (dashboard/) uses it as NYRUS_API_KEY. Without it the
# cyrus-tools MCP endpoint (/mcp/cyrus-tools) skips its auth check and the
# config API (/api/*) is locked. The Nginx config in deploy/forge/README.md
# blocks /mcp/ and /api/ from outside either way.
# With Slack: also set SLACK_DIRECT_WEBHOOKS=true (see the Slack section).
CYRUS_API_KEY=

# --- Claude (required for agent sessions; set exactly one) ------------------
# API key from console.anthropic.com (billed per use) ...
ANTHROPIC_API_KEY=
# ... or a long-lived token for a Claude subscription: run `claude setup-token`
# on a machine where you are signed in, paste the token here.
# CLAUDE_CODE_OAUTH_TOKEN=

# --- GitHub (required for pull requests; set one of the two) -----------------
# A) GitHub App (pull requests show as "<app>[bot]", no user seat needed).
#    App ID and installation ID from the App's settings; its private key goes
#    to ~/.cyrus/github-app.pem (chmod 600). Each agent session gets a fresh
#    installation token as GH_TOKEN. See deploy/forge/README.md.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# B) Token of a GitHub bot account (fine-grained: Contents + Pull requests
#    read/write on the target repositories). Also run `gh auth login` as that
#    account on the server so the agent's `gh` calls work.
GITHUB_TOKEN=

# --- Slack (optional: chat with nyrus in Slack) -----------------------------
# From the Slack app: OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
# and Basic Information -> App Credentials -> Signing Secret. Slack requests
# are verified by signature; since CYRUS_API_KEY is set, this needs
# SLACK_DIRECT_WEBHOOKS=true (otherwise nyrus expects the hosted proxy's token).
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_DIRECT_WEBHOOKS=true
# Ignore thread replies; only react to messages that @mention the bot.
# CYRUS_SLACK_THREAD_FOLLOWING_DISABLED=true

# --- ClickUp (AP3, names not final; the ClickUp integration defines them) ---
# CLICKUP_API_TOKEN=          # personal API token of the ClickUp bot user
# CLICKUP_TEAM_ID=            # workspace id (14278081 for novu)
# CLICKUP_WEBHOOK_SECRET=     # secret ClickUp returns when the webhook is created

# --- Jira (AP4, names not final; the Jira integration defines them) ---------
# JIRA_BASE_URL=https://<site>.atlassian.net
# JIRA_EMAIL=                 # Jira bot account
# JIRA_API_TOKEN=             # API token of the bot account (id.atlassian.com)
# JIRA_WEBHOOK_SECRET=        # secret set on the Jira webhook

# --- Optional -----------------------------------------------------------------
# CYRUS_LOG_LEVEL=info

# --- Do NOT set on Forge ----------------------------------------------------------
# CYRUS_HOST_EXTERNAL   binds to 0.0.0.0 and turns on webhook IP allowlists;
#                       not needed behind Nginx (nyrus listens on localhost).
# CYRUS_TEAM_ID, CYRUS_APP_URL   only for the hosted Cyrus cloud (together
#                       with CYRUS_API_KEY they mirror session transcripts there).
# LINEAR_*              we don't use Linear.
# CLOUDFLARE_TOKEN      not needed, Nginx receives the webhooks.
