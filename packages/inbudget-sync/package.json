{
	"name": "cyrus-inbudget-sync",
	"version": "0.2.78",
	"description": "Repositories and ticket routing from inBudget projects (their Git, Jira and ClickUp links)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/teamnovu/nyrus.git",
		"directory": "packages/inbudget-sync"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo",
		"dev": "tsgo --watch",
		"typecheck": "tsgo --noEmit",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"dependencies": {
		"cyrus-comment-sessions": "workspace:*",
		"cyrus-config-updater": "workspace:*",
		"cyrus-core": "workspace:*",
		"fastify": "^5.12.7"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.12"
	},
	"publishConfig": {
		"access": "public"
	}
}
